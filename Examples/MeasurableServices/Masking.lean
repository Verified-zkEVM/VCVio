module
public import VCVio.ProgramLogic.Relational.ConditionalView
public import ToMathlib.Probability.UniformOn

/-!
# Finite masking through a restricted observation

A secret and a fresh mask are independent fair bits. Either masked share alone can be
simulated by a fair bit without the secret. Both shares reconstruct the secret. The example
uses only finite spaces: the non-maximal σ-algebra is the observer's information, not the
underlying source of randomness. The named simulator is explicit; its efficiency is trivial.
-/

public section

open MeasureTheory ProbabilityTheory
open scoped ENNReal

namespace MeasurableMasking

/-- The joint source of a secret bit and its independent fresh mask. -/
noncomputable def source : Measure (Bool × Bool) := uniformOn Set.univ

instance : IsProbabilityMeasure source := by unfold source; infer_instance

/-- The masked share of the secret. The second source coordinate is the other share. -/
@[expose] def masked (p : Bool × Bool) : Bool := p.1 ^^ p.2

/-- A simulator that draws a fresh fair bit and uses no secret information. -/
noncomputable def simulator : Kernel Unit Bool := Kernel.const Unit (uniformOn Set.univ)

/-- Masking permutes the joint uniform source while retaining the secret. -/
theorem joint_masked_law : source.map (fun p => (p.1, masked p)) = source := by
  apply map_uniformOn_univ_of_bijective Measurable.of_discrete
  apply Function.Involutive.bijective
  intro p
  rcases p with ⟨s, r⟩
  cases s <;> cases r <;> rfl

/-- The masked share is uniformly distributed. -/
theorem masked_law : source.map masked = uniformOn Set.univ := by
  have h := congrArg (fun μ : Measure (Bool × Bool) => μ.map Prod.snd) joint_masked_law
  rw [Measure.map_map measurable_snd Measurable.of_discrete] at h
  simpa only [Function.comp_def, source, uniformOn_univ_prod, Measure.map_snd_prod,
    measure_univ, one_smul] using h

/-- Retaining the secret does not change the masked share's distribution. -/
theorem secret_indep_masked : IndepFun Prod.fst masked source := by
  apply (indepFun_iff_map_prod_eq_prod_map_map measurable_fst.aemeasurable
    Measurable.of_discrete.aemeasurable).mpr
  rw [joint_masked_law, masked_law]
  simp only [source, uniformOn_univ_prod, Measure.map_fst_prod, measure_univ, one_smul]

/-- The explicit fair-bit simulator reproduces a masked-share probe with the secret retained. -/
theorem masked_simulated :
    SimulatesView Prod.fst (fun _ : Bool × Bool => ()) masked simulator source := by
  apply SimulatesView.of_indepFun measurable_fst measurable_const Measurable.of_discrete
    _ (uniformOn Set.univ) masked_law
  exact secret_indep_masked.comp (measurable_const.prodMk measurable_id) measurable_id

/-- Revealing both shares recovers the secret exactly. -/
theorem both_shares_recover (p : Bool × Bool) : (masked p ^^ p.2) = p.1 := by
  rcases p with ⟨s, r⟩
  cases s <;> cases r <;> rfl

/-- Revealing the secret is outside the information generated by the masked share alone. -/
theorem secret_not_observable :
    ¬ @Measurable (Bool × Bool) Bool (MeasurableSpace.comap masked inferInstance) _ Prod.fst := by
  intro h
  obtain ⟨event, _, heq⟩ := h (measurableSet_singleton true)
  have hfalse := congrArg (fun e : Set (Bool × Bool) => (false, false) ∈ e) heq
  have htrue := congrArg (fun e : Set (Bool × Bool) => (true, true) ∈ e) heq
  simp only [Set.mem_preimage, masked, Bool.xor_self,
    Set.mem_singleton_iff, Bool.false_eq_true] at hfalse htrue
  simp_all

/-- The joint observation of both shares is not independent of the secret. -/
theorem both_shares_not_independent :
    ¬ IndepFun Prod.fst (fun p : Bool × Bool => (masked p, p.2)) source := by
  intro h
  have hi : IndepFun (Prod.fst : Bool × Bool → Bool) Prod.fst source := by
    have hh := h.comp measurable_id (show Measurable (fun p : Bool × Bool => p.1 ^^ p.2)
      from Measurable.of_discrete)
    change IndepFun (Prod.fst : Bool × Bool → Bool)
      (fun p => masked p ^^ p.2) source at hh
    rwa [show (fun p => masked p ^^ p.2) = Prod.fst from funext both_shares_recover] at hh
  have he := hi.measure_inter_preimage_eq_mul {true} {true} (measurableSet_singleton true)
    (measurableSet_singleton true)
  have hm : source (Prod.fst ⁻¹' ({true} : Set Bool)) = (2 : ℝ≥0∞)⁻¹ := by
    rw [← Measure.map_apply measurable_fst (measurableSet_singleton true)]
    simp only [source, uniformOn_univ_prod, Measure.map_fst_prod, measure_univ, one_smul,
      uniformOn_univ_apply_singleton, Fintype.card_bool, Nat.cast_ofNat]
  rw [Set.inter_self, hm] at he
  have hr := congrArg ENNReal.toReal he
  norm_num [ENNReal.toReal_mul, ENNReal.toReal_inv] at hr

end MeasurableMasking
