/-!
# FreshL needs long attacker tapes

FreshL (`Valid.nonDed_freshL`) assumes models whose attacker tape is eventually longer than every
polynomial (`Model.LongTapes`). This file shows the assumption is needed: in a model with an empty
attacker tape, against a class meeting every closure field, every other hypothesis of FreshL holds
and its premise holds, and its conclusion fails (`freshL_needs_longTapes`).

* **The class.** `Gen M` is the least predicate on machines closed under the constructions of the
  closure fields of `AdvClass` (relabelling, substitution, querying an input at another input,
  honest symbols, branching, shifting the tape by a polynomial, the guessing machine) and
  containing their base machines (the input projections, Boolean constants, the equality test and
  the samplers of types with polynomial bit blocks). It supplies no `η`-indexed constant beyond
  Booleans and the model's honest symbols and samplers. Every machine of `Gen M` has polynomial
  read and query bounds, by induction into `AdvClass.all` (`Gen.mem_all`), so `genClass M` is an
  `AdvClass`.
* **The model.** `cmodel` has no attacker tape (`lenA = 0`), one base type `msg` whose values are
  the bitstrings `[true]` and `[false]`, two names `n, m : bool → msg`, and the honest index `idx`.
  A name of type `msg` reads `η + 1` bits and is `[false]` exactly when they are all `false`: it is
  `[true]` except with probability `2^{-(η+1)}`.
* **The invariant** (`Gen.clean`): on inputs in which `[true]` does not occur, no machine of
  `Gen cmodel` outputs `[true]`. The tape is empty, so the sampler reads the all-`false` block and
  returns `[false]`; no honest symbol has type `msg`; every other construction only passes values
  on. The guessing machine returns an argument of one of its queries, so the induction also shows
  that every query a generated machine makes on such inputs has arguments in which `[true]` does
  not occur. So with nothing on the left no admitted machine guesses `m` except with probability
  `2^{-(η+1)}`: `[] ⊬ m` holds. But the identity on `n` computes `m` whenever both are `[true]`,
  with probability close to one, so `n ⊬ m` fails, although `n` is fresh in `m`.

The two names have one likely value, not two values sharing their mass, so the failure of `n ⊬ m`
follows from the marginals by a union bound.

## References

* [CCS26] Hérouard, Jacomme, Koutsos, Lallemand, *Secrecy in Squirrel and the Post-Compromise
  Security of a Ratchet*, CCS 2026: Fig. 11 and App. C.2.
-/

public section

namespace Interop.Squirrel.FreshLCountermodel

open IPFunctor IPFunctor.ScopedSignature

/-! ## The class generated by the closure fields -/

section Gen

variable {B : Type} {D : Decl B}

/-- The machines generated by the constructions of the closure fields of `AdvClass` from their
base machines. -/
inductive Gen (M : Model D) : {τs : List (Ty B)} → {β : Ty B} → Machine M τs β → Prop
  /-- Relabelling the inputs. -/
  | rename {τs τs' : List (Ty B)} {β : Ty B} (r : Renaming τs τs') {A : Machine M τs β} :
      Gen M A → Gen M (A.rename r)
  /-- Substitution into a handler. -/
  | subst {as : List (Ty B)} {ρ : Ty B} {τs : List (Ty B)} {β : Ty B}
      {A : Machine M (Ty.arrows as ρ :: τs) β} {K : Machine M (as ++ (ρ.args ++ τs)) ρ.res} :
      Gen M A → Gen M K → Gen M (A.subst K)
  /-- Querying an input at another input. -/
  | app {a b : Ty B} {τs : List (Ty B)} {β : Ty B} (ha : a.IsGround) {A : Machine M (b :: τs) β} :
      Gen M A → Gen M (A.app ha)
  /-- Answering an input by an honest symbol. -/
  | fn {τ : Ty B} {τs : List (Ty B)} {β : Ty B} (f : D.Fn τ) {A : Machine M (τ :: τs) β} :
      Gen M A → Gen M (A.fn f)
  /-- Returning a Boolean or base input. -/
  | input {τs : List (Ty B)} {a : Ty B} (y : ScopedVar τs a) (ha : a.IsGround) :
      Gen M (Machine.input y ha : Machine M τs a)
  /-- Branching on a Boolean input. -/
  | branch {τs : List (Ty B)} {β : Ty B} {x y : Machine M τs β} :
      Gen M x → Gen M y → Gen M (Machine.branch x y)
  /-- The Boolean constants. -/
  | const {τs : List (Ty B)} (c : Bool) : Gen M (Machine.const c : Machine M τs .bool)
  /-- The equality test. -/
  | eqTest {β : Ty B} (hβ : β.IsGround) : Gen M (Machine.eqTest hβ : Machine M [β, β] .bool)
  /-- Reading the tape a polynomial offset further along. -/
  | shift {τs : List (Ty B)} {β : Ty B} (p : Polynomial ℕ) {A : Machine M τs β} :
      Gen M A → Gen M (A.shift fun η => p.eval η)
  /-- The sampler of a type with polynomial bit blocks. -/
  | sampler {b : Ty B} (hb : b.order ≤ 1) : M.PolyCoins b → Gen M (Machine.sampler b hb)
  /-- The guessing machine. -/
  | guess {a b γ : Ty B} {Γ : List (Ty B)} (p q : Polynomial ℕ) (ha : a.IsGround)
      {A : Machine M (.arrow a b :: Γ) γ} {d : Machine M (.arrow a b :: Γ) a.res} :
      Gen M A → Gen M d →
        Gen M (A.guess (fun η => p.eval η) (fun η => Nat.clog 2 (q.eval η)) ha d)

/-- Every generated machine has polynomial read and query bounds. -/
theorem Gen.mem_all {M : Model D} {τs : List (Ty B)} {β : Ty B} {A : Machine M τs β}
    (h : Gen M A) : (AdvClass.all M).mem A := by
  induction h with
  | rename r _ ih => exact (AdvClass.all M).rename_mem r ih
  | subst _ _ ihA ihK => exact (AdvClass.all M).subst_mem ihA ihK
  | app ha _ ih => exact (AdvClass.all M).app_mem ha ih
  | fn f _ ih => exact (AdvClass.all M).fn_mem f ih
  | input y ha => exact (AdvClass.all M).input_mem y ha
  | branch _ _ ihx ihy => exact (AdvClass.all M).branch_mem ihx ihy
  | const c => exact (AdvClass.all M).const_mem c
  | eqTest hβ => exact (AdvClass.all M).eqTest_mem hβ
  | shift p _ ih => exact (AdvClass.all M).shift_mem p ih
  | sampler hb hc => exact (AdvClass.all M).sampler_mem hb hc
  | guess p q ha _ _ ihA ihd => exact (AdvClass.all M).guess_mem p q ha ihA ihd

/-- The class generated by the closure fields. -/
@[expose] def genClass (M : Model D) : AdvClass M where
  mem A := Gen M A
  rename_mem r := Gen.rename r
  subst_mem := Gen.subst
  app_mem ha := Gen.app ha
  fn_mem f := Gen.fn f
  input_mem y ha := Gen.input y ha
  branch_mem := Gen.branch
  const_mem c := Gen.const c
  eqTest_mem hβ := Gen.eqTest hβ
  shift_mem p := Gen.shift p
  sampler_mem hb := Gen.sampler hb
  readBound_mem h := h.mem_all.1
  queryBound_mem h := h.mem_all.2
  guess_mem p q ha := Gen.guess p q ha

end Gen

/-! ## The model -/

/-- The base type of messages. -/
abbrev msg : Ty Unit := .base ()

/-- Two message names, indexed by a Boolean. -/
inductive Name : Ty Unit → Ty Unit → Type where
  /-- The name added by FreshL. -/
  | n : Name .bool msg
  /-- The secret. -/
  | m : Name .bool msg

/-- The honest symbols: an index. -/
inductive Fn : Ty Unit → Type where
  /-- The index at which names are read. -/
  | idx : Fn .bool

-- The decision procedure is exposed, so that `decide` evaluates it in other modules.
@[expose] public section

deriving instance DecidableEq for Name

end

/-- No labels; two names, one index, no attacker symbol. -/
@[expose, reducible] def decl : Decl Unit where
  labels _ _ := False
  Name := Name
  nameDom_finite := fun n => match n with | .n | .m => nofun
  finite_names := Finite.of_injective (β := Bool)
    (fun n => match n with | ⟨_, _, .n⟩ => false | ⟨_, _, .m⟩ => true)
    fun | ⟨_, _, .n⟩, ⟨_, _, .n⟩, _ => rfl | ⟨_, _, .m⟩, ⟨_, _, .m⟩, _ => rfl
  Fn := Fn
  Att := Empty
  attTy f := f.elim

/-- Messages are the bitstrings of length one. -/
@[expose] def carrier : Unit → ℕ → Set (List Bool) := fun _ _ => {l | l.length = 1}

theorem carrier_finite (u : Unit) (η : ℕ) : (carrier u η).Finite := List.finite_length_eq Bool 1

/-- A value of each type in which `[true]` does not occur. -/
@[expose] def cleanVal (η : ℕ) : (τ : Ty Unit) → τ.Value carrier η
  | .bool => false
  | .base _ => ⟨[false], rfl⟩
  | .arrow _ τ => fun _ => cleanVal η τ

/-- The attacker tape is empty. A message name reads `η + 1` bits and is `[true]` unless they are
all `false`; names of other types return values without `[true]`. -/
@[expose] noncomputable def cmodel : Model decl where
  lenA _ := 0
  carrier := carrier
  nonempty _ _ := ⟨[false], rfl⟩
  coinLen η τ := match τ with
    | .base _ => η + 1
    | _ => 0
  sample η τ := match τ with
    | .base _ => fun c => ⟨[decide (∃ j, c j = true)], rfl⟩
    | .bool => fun _ => false
    | .arrow _ _ => fun _ => cleanVal η _
  finite_index η {a _} _ := a.finite_value_of_finite carrier_finite η
  fn _ {τ} f := match τ, f with
    | _, .idx => false
  att _ f := f.elim

/-! ## The invariant -/

/-- The value contains no `[true]`: at `msg` it is `[false]`, and a function maps such values to
such values. -/
@[expose] def Clean (η : ℕ) : (τ : Ty Unit) → τ.Value carrier η → Prop
  | .bool, _ => True
  | .base _, v => v.1 ≠ [true]
  | .arrow σ τ, f => ∀ x, Clean η σ x → Clean η τ (f x)

/-- Every entry of a vector of values is clean. -/
abbrev CleanVals {η : ℕ} {τs : List (Ty Unit)} (e : Vals cmodel η τs) : Prop :=
  ∀ τ x, Clean η τ (e τ x)

variable {η : ℕ}

theorem clean_cleanVal : ∀ τ : Ty Unit, Clean η τ (cleanVal η τ)
  | .bool => trivial
  | .base _ => by simp [Clean, cleanVal]
  | .arrow _ τ => fun _ _ => clean_cleanVal τ

theorem CleanVals.cons {τ : Ty Unit} {τs : List (Ty Unit)} {x : τ.Value carrier η}
    {e : Vals cmodel η τs} (hx : Clean η τ x) (he : CleanVals e) :
    CleanVals (Env.cons x e : Vals cmodel η (τ :: τs)) := fun _ y => by
  cases y with
  | zero => exact hx
  | succ y => exact he _ y

theorem CleanVals.append {τs : List (Ty Unit)} {e' : Vals cmodel η τs} (he' : CleanVals e') :
    ∀ {Ξ : List (Ty Unit)} {e : Vals cmodel η Ξ}, CleanVals e →
      CleanVals (Env.append e e' : Vals cmodel η (Ξ ++ τs))
  | [], _, _ => he'
  | _ :: _, _, he => CleanVals.cons (he _ .zero) (CleanVals.append he' fun _ y => he _ y.succ)

theorem clean_apply : ∀ {τ : Ty Unit} {v : τ.Value carrier η} {q : Vals cmodel η τ.args},
    Clean η τ v → CleanVals q → Clean η τ.res (Ty.apply v q)
  | .bool, _, _, hv, _ => hv
  | .base _, _, _, hv, _ => hv
  | .arrow _ τ, _, _, hv, hq => clean_apply (τ := τ) (hv _ (hq _ .zero)) fun _ y => hq _ y.succ

theorem clean_curry : ∀ {τ : Ty Unit} {g : Vals cmodel η τ.args → τ.res.Value carrier η},
    (∀ q, CleanVals q → Clean η τ.res (g q)) → Clean η τ (Ty.curry g)
  | .bool, _, _ => trivial
  | .base _, _, h => h Env.empty fun _ y => nomatch y
  | .arrow _ _, _, h => fun _ hx => clean_curry fun _ hq => h _ (hq.cons hx)

theorem clean_curryVals {β : Ty Unit} :
    ∀ {as : List (Ty Unit)} {G : Vals cmodel η as → β.Value carrier η},
      (∀ x, CleanVals x → Clean η β (G x)) → Clean η (Ty.arrows as β) (Ty.curryVals G)
  | [], _, h => h Env.empty fun _ y => nomatch y
  | _ :: _, _, h => fun _ hx => clean_curryVals fun _ hy => h _ (hy.cons hx)

private theorem cleanVals_groundArgs {a : Ty Unit} (ha : a.IsGround) :
    CleanVals (Ty.groundArgs (carrier := carrier) (η := η) ha) := by
  cases a with
  | bool => exact fun _ y => nomatch y
  | base _ => exact fun _ y => nomatch y
  | arrow _ _ => exact ha.elim

private theorem cleanVals_splitArgs {ρ : Ty Unit} : ∀ (as : List (Ty Unit))
    {q : Vals cmodel η (Ty.arrows as ρ).args}, CleanVals q →
      CleanVals (Ty.splitArgs as q).1 ∧ CleanVals (Ty.splitArgs as q).2
  | [], _, hq => ⟨(fun _ y => nomatch y), hq⟩
  | _ :: as, q, hq =>
    have h := cleanVals_splitArgs as (q := fun _ y => q _ y.succ) fun _ y => hq _ y.succ
    ⟨CleanVals.cons (hq _ .zero) h.1, h.2⟩

/-! ## Clean queries

The guessing machine returns an argument of a query, so the invariant also covers queries: on
clean inputs, every query a generated machine makes to its inputs has clean arguments. -/

section Queries

variable {τs τs' : List (Ty Unit)} {α : Type}

/-- A query whose arguments are clean; tape reads have none. -/
private def QClean : ℕ ⊕ cmodel.InQuery η τs → Prop
  | .inl _ => True
  | .inr q => CleanVals q.2.2

/-- Every query of the run of `oa` with the answers `ans` has clean arguments. -/
private abbrev RunClean (ans : QueryImpl (cmodel.Iface η τs) Id)
    (oa : OracleComp (cmodel.Iface η τs) α) : Prop :=
  ∀ e ∈ OracleComp.runLog ans oa, QClean e.1

variable {ans : QueryImpl (cmodel.Iface η τs) Id}

private theorem runClean_bind {β : Type} {oa : OracleComp (cmodel.Iface η τs) α}
    {f : α → OracleComp (cmodel.Iface η τs) β} (h : RunClean ans oa)
    (h' : RunClean ans (f (evalWithAnswerFn ans oa))) : RunClean ans (oa >>= f) := by
  intro e he
  rw [OracleComp.runLog_bind, List.mem_append] at he
  exact he.elim (h e) (h' e)

private theorem runClean_pure (a : α) :
    RunClean ans (pure a : OracleComp (cmodel.Iface η τs) α) :=
  fun _ h => absurd h (by simp)

private theorem runClean_elim {X : Type} {o : Option X} {d : OracleComp (cmodel.Iface η τs) α}
    {f : X → OracleComp (cmodel.Iface η τs) α} (hd : RunClean ans d)
    (hf : ∀ x, RunClean ans (f x)) : RunClean ans (o.elim d f) := by
  cases o
  · exact hd
  · exact hf _

private theorem runClean_read (i : ℕ) :
    RunClean ans (Machine.read i : OracleComp (cmodel.Iface η τs) _) :=
  OracleComp.forall_mem_runLog_of_allQueriesSatisfy ans
    ((OracleComp.allQueriesSatisfy_query_iff _ _).2 trivial)

private theorem runClean_ask {q : cmodel.InQuery η τs} (hq : CleanVals q.2.2) :
    RunClean ans (Machine.ask q) :=
  OracleComp.forall_mem_runLog_of_allQueriesSatisfy ans
    ((OracleComp.allQueriesSatisfy_query_iff _ QClean).2 hq)

private theorem runClean_fetch {a : Ty Unit} (y : ScopedVar τs a) (ha : a.IsGround) :
    RunClean ans (Machine.fetch y ha) := by
  rw [Machine.fetch]
  intro e he
  rw [OracleComp.runLog_map] at he
  exact runClean_ask (cleanVals_groundArgs ha) e he

private theorem runClean_readBits : ∀ n k : ℕ,
    RunClean ans (Machine.readBits n k : OracleComp (cmodel.Iface η τs) _)
  | _, 0 => runClean_pure _
  | n, k + 1 => runClean_bind (runClean_read n)
      (runClean_bind (runClean_readBits (n + 1) k) (runClean_pure _))

private theorem runClean_fetchVals : ∀ {Ξ : List (Ty Unit)} (r : Renaming Ξ τs)
    (h : ∀ τ ∈ Ξ, τ.IsGround), RunClean ans (Machine.fetchVals r h)
  | [], _, _ => runClean_pure _
  | _ :: _, _, _ => runClean_bind (runClean_fetch _ _)
      (runClean_bind (runClean_fetchVals _ _) (runClean_pure _))

/-- A program run through a handler of queries makes clean queries when the program, run with the
answers the handler gives, makes clean queries and the handler answers each of them with a program
that makes clean queries. -/
private theorem runClean_simulateQ' {ans' : QueryImpl (cmodel.Iface η τs') Id}
    {impl : QueryImpl (cmodel.Iface η τs) (OracleComp (cmodel.Iface η τs'))}
    (himpl : ∀ t, QClean t → RunClean ans' (impl t))
    {oa : OracleComp (cmodel.Iface η τs) α}
    (hoa : RunClean (fun t => evalWithAnswerFn ans' (impl t)) oa) :
    RunClean ans' (simulateQ impl oa) := fun _ he => by
  obtain ⟨e₀, he₀, he⟩ := (OracleComp.mem_runLog_simulateQ _ _ _).1 he
  exact himpl e₀.1 (hoa e₀ he₀) _ he

/-- A program run through a handler that answers as clean values, and whose answers to clean
queries make clean queries, makes clean queries when the program does. -/
private theorem runClean_simulateQ {ρa : cmodel.TapeA η} {e : Vals cmodel η τs'}
    {e' : Vals cmodel η τs} {H : Handler cmodel η τs τs'} (hev : H.EvalsTo ρa e e')
    (hH : ∀ τ x q, CleanVals q → RunClean (cmodel.answer ρa e) (H τ x q))
    {oa : OracleComp (cmodel.Iface η τs) α} (hoa : RunClean (cmodel.answer ρa e') oa) :
    RunClean (cmodel.answer ρa e) (simulateQ H.impl oa) := by
  have hind :
      (fun t => evalWithAnswerFn (cmodel.answer ρa e) (H.impl t)) = cmodel.answer ρa e' := by
    funext t
    rcases t with i | ⟨τ, x, q⟩
    · rfl
    · exact hev τ x q
  refine runClean_simulateQ' (fun t ht => ?_) (hind ▸ hoa)
  rcases t with i | ⟨τ, x, q⟩
  · exact runClean_read i
  · exact hH τ x q ht

/-- Every answer of the handler to a clean query makes only clean queries. -/
private abbrev HClean {ρa : cmodel.TapeA η} {e : Vals cmodel η τs'}
    (H : Handler cmodel η τs τs') : Prop :=
  ∀ τ x q, CleanVals q → RunClean (cmodel.answer ρa e) (H τ x q)

private theorem hClean_ofVals {ρa : cmodel.TapeA η} {e : Vals cmodel η τs'}
    (v : Vals cmodel η τs) :
    HClean (ρa := ρa) (e := e) (InputImpl.ofVals v : Handler cmodel η τs τs') :=
  fun _ _ _ _ => runClean_pure _

private theorem hClean_fwd {ρa : cmodel.TapeA η} {e : Vals cmodel η τs'} (r : Renaming τs τs') :
    HClean (ρa := ρa) (e := e) (Handler.fwd r : Handler cmodel η τs τs') :=
  fun _ _ _ hq => runClean_ask hq

private theorem HClean.append {ρa : cmodel.TapeA η} {e : Vals cmodel η τs'}
    {H₂ : Handler cmodel η τs τs'} : ∀ {Ξ : List (Ty Unit)} {H₁ : Handler cmodel η Ξ τs'},
      HClean (ρa := ρa) (e := e) H₁ → HClean (ρa := ρa) (e := e) H₂ →
        HClean (ρa := ρa) (e := e) (Env.append H₁ H₂ : Handler cmodel η (Ξ ++ τs) τs')
  | [], _, _, h₂ => h₂
  | _ :: _, _, h₁, h₂ => by
    intro _ x q hq
    cases x with
    | zero => exact h₁ _ .zero q hq
    | succ x => exact HClean.append (fun _ y q hq => h₁ _ y.succ q hq) h₂ _ x q hq

/-- The arguments of a logged query to the first input are clean. -/
private theorem cleanVals_of_mem_firstArgs {σ : Ty Unit} {Γ : List (Ty Unit)}
    {ans : QueryImpl (cmodel.Iface η (σ :: Γ)) Id} {oa : OracleComp (cmodel.Iface η (σ :: Γ)) α}
    (h : RunClean ans oa) {q : Vals cmodel η σ.args}
    (hq : q ∈ cmodel.firstArgs (OracleComp.runLog ans oa)) : CleanVals q := by
  obtain ⟨⟨t, r⟩, hent, hf⟩ := List.mem_filterMap.1 hq
  rcases t with i | ⟨τ, x, q'⟩
  · exact absurd hf (by simp [Model.firstArg])
  · cases x with
    | zero =>
      obtain rfl := Option.some.inj hf
      exact h _ hent
    | succ x => exact absurd hf (by simp [Model.firstArg])

end Queries

/-- On clean inputs, every query of the run has clean arguments. -/
private abbrev ArgsClean {τs : List (Ty Unit)} {β : Ty Unit} (A : Machine cmodel τs β) : Prop :=
  ∀ η (ρa : cmodel.TapeA η) (e : Vals cmodel η τs), CleanVals e →
    RunClean (cmodel.answer ρa e) (A η)

private theorem ArgsClean.rename {τs τs' : List (Ty Unit)} {β : Ty Unit}
    {A : Machine cmodel τs β} (h : ArgsClean A) (r : Renaming τs τs') :
    ArgsClean (A.rename r) := fun η ρa _ he =>
  runClean_simulateQ (Handler.evalsTo_fwd r) (hClean_fwd r) (h η ρa _ fun _ y => he _ (r _ y))

/-- **The invariant**, with queries. On clean inputs, every generated machine returns a clean
value and makes only queries with clean arguments: the empty tape gives the sampler the
all-`false` block, no honest symbol has type `msg`, every other construction only passes values
on, and the guessing machine returns an argument of a clean query. -/
private theorem Gen.clean_argsClean {τs : List (Ty Unit)} {β : Ty Unit}
    {A : Machine cmodel τs β} (h : Gen cmodel A) :
    (∀ η (ρa : cmodel.TapeA η) (e : Vals cmodel η τs), CleanVals e →
      Clean η β (A.run η ρa e)) ∧ ArgsClean A := by
  induction h with
  | rename r _ ih =>
    refine ⟨fun η ρa e he => ?_, ih.2.rename r⟩
    rw [Machine.run_rename]
    exact ih.1 η ρa _ fun _ y => he _ (r _ y)
  | subst _ _ ihA ihK =>
    rename_i as ρ τs β A K _ _
    have hK : ∀ η (ρa : cmodel.TapeA η) (e : Vals cmodel η τs), CleanVals e →
        CleanVals (Env.cons (Ty.curryVals fun x => Ty.curry fun y =>
          K.run η ρa (Env.append x (Env.append y e))) e : Vals cmodel η (_ :: τs)) :=
      fun η ρa e he => CleanVals.cons (clean_curryVals fun _ hx => clean_curry fun _ hy =>
        ihK.1 η ρa _ (CleanVals.append (CleanVals.append he hy) hx)) he
    refine ⟨fun η ρa e he => ?_, fun η ρa e he => ?_⟩
    · rw [Machine.run_subst]
      exact ihA.1 η ρa _ (hK η ρa e he)
    · refine runClean_simulateQ (e' := Env.cons (Ty.curryVals fun x => Ty.curry fun y =>
          K.run η ρa (Env.append x (Env.append y e))) e) ?_ (fun τ x q hq => ?_)
        (ihA.2 η ρa _ (hK η ρa e he))
      · refine Handler.EvalsTo.cons (fun q => ?_) (Handler.evalsTo_fwd _)
        rw [evalWithAnswerFn_map, Handler.EvalsTo.evalWithAnswerFn_simulateQ
          ((Handler.evalsTo_ofVals _).append ((Handler.evalsTo_ofVals _).append
            (Handler.evalsTo_fwd _))), Ty.apply_curryVals_curry]
        rfl
      · cases x with
        | zero =>
          intro ent hent
          change ent ∈ OracleComp.runLog (cmodel.answer ρa e)
            (Ty.resArrows as <$> simulateQ _ (K η)) at hent
          rw [OracleComp.runLog_map] at hent
          obtain ⟨h₁, h₂⟩ := cleanVals_splitArgs as hq
          exact runClean_simulateQ ((Handler.evalsTo_ofVals _).append
            ((Handler.evalsTo_ofVals _).append (Handler.evalsTo_fwd _)))
            ((hClean_ofVals _).append ((hClean_ofVals _).append (hClean_fwd _)))
            (ihK.2 η ρa _ (CleanVals.append (CleanVals.append he h₂) h₁)) ent hent
        | succ x => exact runClean_ask hq
  | app ha _ ih =>
    rename_i a b τs β A _
    refine ⟨fun η ρa e he => ?_, fun η ρa e he => ?_⟩
    · rw [Machine.run_app]
      exact ih.1 η ρa _ (CleanVals.cons (he _ .zero _ (he _ (.succ .zero))) fun _ y =>
        he _ y.succ.succ)
    · unfold Machine.app Machine.handle
      refine runClean_simulateQ ?_ (fun τ x q hq => ?_)
        (ih.2 η ρa _ (CleanVals.cons (he _ .zero _ (he _ (.succ .zero))) fun _ y =>
          he _ y.succ.succ))
      · exact Handler.EvalsTo.cons (fun q => (evalWithAnswerFn_bind _ _ _).trans
          (congrArg (fun x => Ty.apply (τ := .arrow a b) (e _ .zero) (Env.cons x q))
            (Machine.evalWithAnswerFn_fetch e _ ha))) (Handler.evalsTo_fwd _)
      cases x with
      | zero =>
        refine runClean_bind (runClean_fetch _ ha) (runClean_ask ?_)
        rw [Machine.evalWithAnswerFn_fetch]
        exact CleanVals.cons (he _ (.succ .zero)) hq
      | succ x => exact runClean_ask hq
  | fn f _ ih =>
    refine ⟨fun η ρa e he => ?_, fun η ρa e he => ?_⟩
    · rw [Machine.run_fn]
      cases f
      exact ih.1 η ρa _ (CleanVals.cons trivial he)
    · refine runClean_simulateQ (Handler.EvalsTo.cons (fun _ => rfl) (Handler.evalsTo_fwd _))
        (fun τ x q hq => ?_) (ih.2 η ρa _ (by cases f; exact CleanVals.cons trivial he))
      cases x with
      | zero => exact runClean_pure _
      | succ x => exact runClean_ask hq
  | input y ha =>
    exact ⟨fun η ρa e he => by rw [Machine.run_input]; exact he _ y,
      fun _ _ _ _ => runClean_fetch y ha⟩
  | branch _ _ ihx ihy =>
    refine ⟨fun η ρa e he => ?_, fun η ρa e he => ?_⟩
    · rw [Machine.run_branch]
      cases e _ .zero
      · exact ihy.1 η ρa _ fun _ y => he _ y.succ
      · exact ihx.1 η ρa _ fun _ y => he _ y.succ
    · refine runClean_bind (runClean_ask fun _ y => nomatch y) ?_
      change RunClean _ (cond (e _ .zero) _ _)
      cases e _ .zero
      · exact (ihy.2.rename _) η ρa e he
      · exact (ihx.2.rename _) η ρa e he
  | const c => exact ⟨fun _ _ _ _ => trivial, fun _ _ _ _ => runClean_pure _⟩
  | eqTest hβ =>
    exact ⟨fun _ _ _ _ => trivial, fun _ _ _ _ => runClean_bind (runClean_fetch _ hβ)
      (runClean_bind (runClean_fetch _ hβ) (runClean_pure _))⟩
  | shift p _ ih =>
    refine ⟨fun η ρa e he => ?_, fun η ρa e he => ?_⟩
    · rw [Machine.run_shift]
      exact ih.1 η _ e he
    · have hind : (fun t => evalWithAnswerFn (cmodel.answer ρa e)
          (Machine.shiftImpl (p.eval η) t)) = cmodel.answer (cmodel.shiftTape (p.eval η) ρa) e := by
        funext t
        rcases t with i | q
        · exact (cmodel.readBit_shiftTape _ _ _).symm
        · rfl
      have h := ih.2 η (cmodel.shiftTape (p.eval η) ρa) e he
      rw [← hind] at h
      refine runClean_simulateQ' (fun t ht => ?_) h
      rcases t with i | q
      · exact runClean_read _
      · exact runClean_ask ht
  | sampler hb hc =>
    rename_i b
    refine ⟨fun η ρa e he => ?_, fun _ _ _ _ => runClean_bind (runClean_readBits _ _)
      (runClean_bind (runClean_fetchVals _ _) (runClean_pure _))⟩
    rw [Machine.run_sampler]
    cases b with
    | bool => trivial
    | base _ => simp [Clean, Ty.res, cmodel, Model.coinAt, Model.readBit, Ty.apply]
    | arrow _ _ => exact clean_apply (clean_cleanVal _) he
  | guess p q ha _ _ ihA ihd =>
    rename_i a b γ Γ A d _ _
    refine ⟨fun η ρa e he => ?_, fun η ρa e he => ?_⟩
    · rw [Machine.run_guess]
      cases hj : (cmodel.firstArgs (OracleComp.runLog (cmodel.answer ρa e) (A η)))[(bitsEquiv
          (Nat.clog 2 (q.eval η)) (cmodel.bitsAt ρa (p.eval η) (Nat.clog 2 (q.eval η))) : ℕ)]? with
      | none => exact ihd.1 η ρa e he
      | some q' => exact clean_apply (cleanVals_of_mem_firstArgs (ihA.2 η ρa e he)
          (List.mem_of_getElem? hj) _ .zero) (cleanVals_groundArgs ha)
    · unfold Machine.guess
      refine runClean_bind (runClean_readBits _ _) (runClean_bind ?_
        (runClean_elim (ihd.2 η ρa e he) fun _ => runClean_pure _))
      intro ent hent
      rw [OracleComp.runLog_withQueryLog] at hent
      exact ihA.2 η ρa e he ent hent

/-- **The invariant.** On clean inputs, every generated machine returns a clean value. -/
theorem Gen.clean {τs : List (Ty Unit)} {β : Ty Unit} {A : Machine cmodel τs β}
    (h : Gen cmodel A) :
    ∀ η (ρa : cmodel.TapeA η) (e : Vals cmodel η τs), CleanVals e → Clean η β (A.run η ρa e) :=
  h.clean_argsClean.1

/-! ## The countermodel -/

/-- A message name at the index `idx`. -/
@[expose] def nm (x : Name .bool msg) : FTerm decl [] msg :=
  FTerm.name (D := decl) x (FTerm.fn (D := decl) Fn.idx)

/-- A message name is `[false]` with probability `2^{-(η+1)}`, the probability of the all-`false`
block. -/
theorem prEvent_nameAt_ne (x : Name .bool msg) (η : ℕ) :
    Pr{let ρ ← $ᵗ (cmodel.Tape η)}[(cmodel.nameAt (D := decl) x Fn.idx η ρ).1 ≠ [true]] =
      ((2 : ENNReal) ^ (η + 1))⁻¹ := by
  refine (prEvent_nameAt (M := cmodel) x Fn.idx η fun v => v.1 ≠ [true]).trans ?_
  have hc : ∀ c : cmodel.Coin η msg, (cmodel.sample η msg c).1 ≠ [true] ↔ c = fun _ => false :=
    fun c => by
      change [decide (∃ j, c j = true)] ≠ [true] ↔ _
      simp only [ne_eq, List.cons.injEq, decide_eq_true_eq, and_true, not_exists,
        Bool.not_eq_true]
      exact ⟨funext, fun h j => congrFun h j⟩
  rw [prEvent_congr _ _ _ hc, SampleableType.prEvent_uniformSample_eq_singleton_natCard]
  change ((Nat.card (Fin (η + 1) → Bool) : ℕ) : ENNReal)⁻¹ = _
  rw [Nat.card_eq_fintype_card, Fintype.card_fun, Fintype.card_bool, Fintype.card_fin,
    Nat.cast_pow, Nat.cast_ofNat]

/-- The probability `2^{-(η+1)}` is negligible. -/
theorem negligible_prEvent_nameAt_ne (x : Name .bool msg) :
    negligible fun η =>
      Pr{let ρ ← $ᵗ (cmodel.Tape η)}[(cmodel.nameAt (D := decl) x Fn.idx η ρ).1 ≠ [true]] := by
  refine negligible_of_le (fun η => ?_) (negligible_two_rpow_neg_mul one_pos)
  rw [prEvent_nameAt_ne, one_mul, ENNReal.rpow_neg, ENNReal.rpow_natCast]
  exact ENNReal.inv_le_inv.2 (pow_le_pow_right₀ (by norm_num) (Nat.le_succ η))

/-- **`[] ⊬ m`** against the generated class: a machine with no inputs returns a clean message,
which is `m` only where `m` is `[false]`. -/
theorem nonDed_m (u : VecRV cmodel []) :
    (genClass cmodel).NonDed u (cmodel.nameAt (D := decl) Name.m Fn.idx) := fun g hg => by
  refine negligible_of_le (fun η => prEvent_mono _ _ _ fun ρ hρ hm => ?_)
    (negligible_prEvent_nameAt_ne Name.m)
  have hc : Clean η msg (g.run η ρ.1 Env.empty) := Gen.clean hg η ρ.1 _ fun _ y => nomatch y
  exact hc ((congrArg Subtype.val (hρ : g.run η ρ.1 Env.empty = _)).trans hm)

/-- **`n ⊬ m` fails** against the generated class: the identity on `n` computes `m` wherever both
are `[true]`, so its success is at least `1` minus two negligible probabilities. -/
theorem not_nonDed_n_m (u : VecRV cmodel []) :
    ¬ (genClass cmodel).NonDed (VecRV.snoc u (cmodel.nameAt (D := decl) Name.n Fn.idx))
      (cmodel.nameAt (D := decl) Name.m Fn.idx) := fun h => by
  have hid := h (Machine.input .zero (Ty.isGround_base ())) (Gen.input _ _)
  refine not_negligible_one (negligible_of_le (fun η => ?_) (negligible_add hid
    (negligible_add (negligible_prEvent_nameAt_ne Name.n) (negligible_prEvent_nameAt_ne Name.m))))
  refine ((OracleComp.prEvent_true_eq_one _).symm.trans_le
    ((prEvent_mono _ (fun _ => True) _ fun ρ _ => ?_).trans
      ((prEvent_or_le _ _ _).trans (add_le_add le_rfl (prEvent_or_le _ _ _)))))
  by_cases hn : (cmodel.nameAt (D := decl) Name.n Fn.idx η ρ).1 = [true]
  · by_cases hm : (cmodel.nameAt (D := decl) Name.m Fn.idx η ρ).1 = [true]
    · exact Or.inl (Subtype.ext (hn.trans hm.symm))
    · exact Or.inr (Or.inr hm)
  · exact Or.inr (Or.inl hn)

/-- **FreshL needs long tapes.** In `cmodel`, against the class generated by the closure fields,
FreshL's premise `[] ⊬ m` is valid and its conclusion `n ⊬ m` is not, while every hypothesis of
FreshL other than long tapes holds: messages have polynomial bit blocks, the terms read nothing of
the attacker tape, and `n` is fresh in the empty vector and in `m` (`decide`). The attacker tape
is empty, so the tapes are not long. -/
theorem freshL_needs_longTapes :
    Valid (· = cmodel) (fun M => genClass M) (Γ := []) [] (.nonDed Env.empty (nm Name.m)) ∧
      ¬ Valid (· = cmodel) (fun M => genClass M) (Γ := []) []
        (.nonDed (Vec.snoc Env.empty (nm Name.n)) (nm Name.m)) ∧
      cmodel.PolyCoins msg ∧ ¬ cmodel.LongTapes ∧
      (∀ (C : AdvClass cmodel) env, Vec.ReadsPoly cmodel C (Env.empty : Vec decl [] []) env ∧
        (nm Name.m).ReadsPoly cmodel C env) ∧
      Vec.AvoidsNames (· = ⟨_, _, Name.n⟩) (Env.empty : Vec decl [] []) ∧
      (nm Name.m).AvoidsNames (· = ⟨_, _, Name.n⟩) := by
  refine ⟨?_, fun h => ?_, ⟨Polynomial.X + 1, fun η => by simp [cmodel]⟩, fun h => ?_,
    fun C env => ⟨(fun _ x => nomatch x), (FTerm.readsPoly_fn _).name _⟩, by decide, by decide⟩
  · rintro M - rfl env -
    exact Form.holds_nonDed.2 (nonDed_m _)
  · have hv := Form.holds_nonDed.1 (h cmodel (fun _ _ h => h.elim) rfl Env.empty (by simp))
    rw [Vec.rv_snoc] at hv
    exact not_nonDed_n_m _ hv
  · obtain ⟨η, hη⟩ := (h 0).exists
    simp [cmodel] at hη

end Interop.Squirrel.FreshLCountermodel
