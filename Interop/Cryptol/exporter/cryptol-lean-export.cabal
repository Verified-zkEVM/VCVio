cabal-version: 2.4
name: cryptol-lean-export
version: 0.1.0.0
build-type: Simple
license: Apache-2.0

executable cryptol-lean-export
  main-is: Main.hs
  default-language: Haskell2010
  ghc-options: -Wall -Werror -Wincomplete-patterns -threaded -rtsopts
  build-depends: base >= 4.18 && < 4.22, aeson >= 2 && < 2.3,
                 bytestring, containers, cryptol == 3.6.0,
                 directory, filepath, text
