/-- The certificates after the first, in order of increasing left endpoint. -/
@[expose] def certRest : List ChebCert :=
  [cert1, cert2, cert3, cert4, cert5, cert6, cert7, cert8, cert9, cert10, cert11, cert12, cert13,
    cert14]

/-- The fifteen certificates all check against `certP`, all bound `|certQ|` by `3574` units, and
cover `[0, 89 / 128]` without gaps. -/
theorem certs_checkCover :
    ChebCert.checkCover certP 6402373705728000 3574 cert0 certRest = true := by
  decide +kernel

/-- The fifteen certificates cover `[0, 89 / 128]`, which contains `[0, log 2)`. -/
theorem abs_certQ_le (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t ≤ 89 / 128) :
    |certQ t| ≤ 3574 := by
  have h := ChebCert.abs_le_of_checkCover (by norm_num) certQ_eval certs_checkCover
    (x := t) (by norm_num [ChebCert.lo, cert0]; exact ht0)
    (by rw [show ChebCert.last cert0 certRest = cert14 from rfl]
        norm_num [ChebCert.hi, cert14]; linarith)
  exact_mod_cast h

end Falcon.Concrete.FPRBridge
