/-! ## Complete original polynomial semantics -/

namespace SLHDSA.Refactor.C2FrozenPolynomial

/-- The original polynomial at all orders, including its above-six zero fallback. -/
private def original (m : Nat → ℝ) (count order : Nat) : ℝ :=
  let n : ℝ := count
  match order with
  | 0 => 1
  | 1 => 0
  | 2 => n * m 2
  | 3 => n * m 3
  | 4 => n * m 4 + 3 * n * (n - 1) * (m 2) ^ 2
  | 5 => n * m 5 + 10 * n * (n - 1) * m 3 * m 2
  | 6 => n * m 6 + 15 * n * (n - 1) * m 4 * m 2 +
      10 * n * (n - 1) * (m 3) ^ 2 +
      15 * n * (n - 1) * (n - 2) * (m 2) ^ 3
  | _ => 0

/-- Exact old-value to generic equation without any order/count restriction. -/
private theorem original_eq_generic (m : Nat → ℝ) (count order : Nat) :
    original m count order = ProbabilityTheory.centeredSumMomentUpToSix m count order := by
  rfl

/-- The public original function retains the complete frozen mathematical value. -/
private theorem sumMoment_eq_original (m : Nat → ℝ) (count order : Nat) :
    SLHDSA.SHAKE128s.ForsConcentration.sumMoment m count order = original m count order := by
  rfl

end SLHDSA.Refactor.C2FrozenPolynomial


