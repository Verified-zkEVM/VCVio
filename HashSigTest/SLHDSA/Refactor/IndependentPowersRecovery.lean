/-- Decode only back-references to earlier literal nodes; string chunks concatenate exactly. -/
private def frozenRows : Except String (Array Json) := do
  let input ← Json.parse frozenDag
  let nodes ← input.getObjValAs? (Array Json) "nodes"
  let roots ← input.getObjValAs? (Array Nat) "roots"
  let mut values : Array Json := #[]
  for node in nodes do
    let fields ← node.getArr?
    let tag ← fields[0]!.getNat?
    let value ← match tag with
      | 0 => do
        let refs ← (fields.extract 1 fields.size).mapM Json.getNat?
        let args ← refs.mapM fun i => do
          unless i < values.size do throw "Forward or invalid literal DAG reference"
          pure values[i]!
        pure (Json.arr args)
      | 1 => do
        let chunks ← (fields.extract 1 fields.size).mapM Json.getStr?
        pure (Json.str (String.join chunks.toList))
      | 2 =>
        if fields.size == 2 then pure fields[1]! else throw "Invalid literal atom"
      | _ => throw "Unknown literal DAG node"
    values := values.push value
  roots.mapM fun i => do
    unless i < values.size do throw "Invalid literal root"
    pure values[i]!

/-- Literal full metadata keys, excluding presentation-only pretty text and theorem proof values. -/
private def semanticFields : Array String := #["name", "module", "levels", "levelNames", "shape",
  "type", "values", "dependencies", "axioms"]

/-- Compare the exact named semantic image and its complete dependency boundary. -/
private def checkDelegatedRows : CommandElabM Unit := do
  let rows ← ofExcept frozenRows
  let env := (← getEnv).setExporting false
  let names := #[
    `SLHDSA.SHAKE128s.ForsConcentration.independent_integrable_add_power,
    `SLHDSA.SHAKE128s.ForsConcentration.independent_integral_add_power,
    `SLHDSA.SHAKE128s.ForsConcentration.sumMoment,
    `SLHDSA.SHAKE128s.ForsConcentration.sumMoment_zero,
    `SLHDSA.SHAKE128s.ForsConcentration.sumMoment_succ,
    `SLHDSA.SHAKE128s.ForsConcentration.independent_sum_moments,
    `SLHDSA.SHAKE128s.ForsConcentration.poisson_centered_sum_moments,
    `SLHDSA.SHAKE128s.ForsConcentration.poissonLoads,
    `SLHDSA.SHAKE128s.ForsConcentration.centeredLoad,
    `SLHDSA.SHAKE128s.ForsConcentration.centeredLoadSum,
    `SLHDSA.SHAKE128s.ForsConcentration.centeredMoment,
    `SLHDSA.SHAKE128s.ForsMoments.touchard,
    `SLHDSA.SHAKE128s.ForsMoments.stirlingRow,
    `ProbabilityTheory.IndepFun.integrable_add_pow,
    `ProbabilityTheory.IndepFun.integral_add_pow,
    `ProbabilityTheory.centeredSumMomentUpToSix,
    `ProbabilityTheory.centeredSumMomentUpToSix_zero,
    `ProbabilityTheory.centeredSumMomentUpToSix_succ,
    `ProbabilityTheory.iIndepFun.integrable_pow_finsetSum_and_integral_eq,
    `ProbabilityTheory.iIndepFun.integral_pow_six_finsetSum_of_signs,
    `SLHDSA.SHAKE128s.ForsConcentration.poisson_sixth_sum_bound,
    `SLHDSA.SHAKE128s.ForsConcentration.poisson_load_tail_sharper]
  let captured ← capture names #["HashSig.SLHDSA.SHAKE128s.Proof.ForsConcentration",
    "HashSig.SLHDSA.SHAKE128s.Proof.ForsMoments", "ToMathlib.Probability.Moments.IndependentPowers"]
  let actualRows ← ofExcept (captured.getObjValAs? (Array Json) "records")
  unless actualRows.size == 31 do throwError "C2 semantic closure changed"
  for i in [:31] do
    let expected ← ofExcept rows[i]!.getArr?
    let name ← ofExcept expected[0]!.getStr?
    let kernelName ← ofExcept (decodeName expected.back!)
    let actual ← captureConstant env kernelName
    unless actualRows.any (fun row => (row.getObjValAs? String "name").toOption == some name) do
      throwError "C2 semantic dependency disappeared: {name}"
    for j in [:semanticFields.size] do
      unless (← ofExcept (actual.getObjVal? semanticFields[j]!)) == expected[j]! do
        throwError "C2 delegated literal mismatch: {name}.{semanticFields[j]!}"
  let boundary ← ofExcept (captured.getObjValAs? (Array Json) "externalBoundary")
  let actualBoundary ← boundary.mapM fun (row : Json) => do
    pure (Json.arr #[← ofExcept (row.getObjVal? "name"), ← ofExcept (row.getObjVal? "module")])
  unless Json.arr actualBoundary == rows[32]! do throwError "C2 external boundary changed"
  let some (.thmInfo proof) := env.find?
      `SLHDSA.SHAKE128s.ForsConcentration.poissonLoads._proof_1
    | throwError "C2 named instance proof is unavailable"
  let expectedProof ← ofExcept rows[31]!.getArr?
  unless (← ofExcept (encodeExpr proof.value)) == expectedProof[0]! &&
      toJson (reprStr proof.value) == expectedProof[1]! do
    throwError "C2 named instance proof RHS changed"
  logInfo "C2_LITERAL_31_FULL_TYPES_VALUES_OWNERS_CLOSURE_AND_NAMED_PROOF_PASS"

