private def requireDirect (caller expectedOwner callee calleeOwner : Name) : CommandElabM Unit := do
  let env := (← getEnv).setExporting false
  unless owner env caller == some expectedOwner do throwError "Unexpected caller owner: {caller}"
  unless owner env callee == some calleeOwner do throwError "Unexpected callee owner: {callee}"
  let some ci := env.find? caller | throwError "Missing required caller {caller}"
  if let .axiomInfo _ := ci then throwError "Private implementation absent: {caller}"
  unless ci.getUsedConstantsAsSet.contains callee do
    throwError "Specific generic route absent: {caller} -> {callee}"

/-- Production-only ownership map: all five delegates must call the specified generic API. -/
private def checkProductionRoutes : CommandElabM Unit := do
  let owner := `HashSig.SLHDSA.SHAKE128s.Proof.ForsConcentration
  let generic := `ToMathlib.Probability.Moments.IndependentPowers
  for (caller, callee) in #[
      (`SLHDSA.SHAKE128s.ForsConcentration.independent_integrable_add_power,
        `ProbabilityTheory.IndepFun.integrable_add_pow),
      (`SLHDSA.SHAKE128s.ForsConcentration.independent_integral_add_power,
        `ProbabilityTheory.IndepFun.integral_add_pow),
      (`SLHDSA.SHAKE128s.ForsConcentration.sumMoment_zero,
        `ProbabilityTheory.centeredSumMomentUpToSix_zero),
      (`SLHDSA.SHAKE128s.ForsConcentration.sumMoment_succ,
        `ProbabilityTheory.centeredSumMomentUpToSix_succ),
      (`SLHDSA.SHAKE128s.ForsConcentration.independent_sum_moments,
        `ProbabilityTheory.iIndepFun.integrable_pow_finsetSum_and_integral_eq)] do
    requireDirect caller owner callee generic
  requireDirect `SLHDSA.SHAKE128s.ForsConcentration.poisson_centered_sum_moments owner
    `SLHDSA.SHAKE128s.ForsConcentration.independent_sum_moments owner
  requireDirect `SLHDSA.SHAKE128s.ForsConcentration.poisson_sixth_sum_bound owner
    `SLHDSA.SHAKE128s.ForsConcentration.poisson_centered_sum_moments owner
  let sharper := `HashSig.SLHDSA.SHAKE128s.Proof.ForsConcentrationSharper
  requireDirect `SLHDSA.SHAKE128s.ForsConcentration.poisson_load_tail_sharper sharper
    `SLHDSA.SHAKE128s.ForsConcentration.poisson_centered_sum_moments owner
  requireDirect `SLHDSA.SHAKE128s.ForsConcentration.poisson_load_tail_sharper sharper
    `SLHDSA.SHAKE128s.ForsConcentration.poisson_sixth_sum_bound owner
  logInfo "ACTUAL_PRODUCTION_FIVE_GENERIC_AND_FOUR_DOWNSTREAM_EDGES_PASS"


run_cmd do
  checkDelegatedRows
  checkProductionRoutes

end SLHDSA.Refactor.C2CompiledEnforcement
end
