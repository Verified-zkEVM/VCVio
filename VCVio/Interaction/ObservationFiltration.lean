module
public import VCVio.Interaction.ObservationMeasure
public import Mathlib.Probability.Process.HittingTime

/-!
# Information available through an evolving public view

The filtration is generated by the observations already made. It describes an information
restriction even when the full state space is finite and has the maximal σ-algebra. A scheduler
or decision measurable for this filtration cannot use unrevealed future or private state.
This restriction must be checked explicitly when connecting a scheduler to a service.
-/

public section

open MeasureTheory

namespace Interaction

variable {Ω V W : Type*} [mΩ : MeasurableSpace Ω] [MeasurableSpace V] [MeasurableSpace W]

/-- The information generated by observations through time `n`, without topological assumptions. -/
def observationFiltration (view : ℕ → Ω → V) (hview : ∀ n, Measurable (view n)) :
    Filtration ℕ (inferInstance : MeasurableSpace Ω) where
  seq n := ⨆ k ≤ n, MeasurableSpace.comap (view k) inferInstance
  mono' _ _ h := iSup_le fun k => iSup_le fun hk =>
    le_iSup_of_le k (le_iSup_of_le (hk.trans h) le_rfl)
  le' _ := iSup_le fun k => iSup_le fun _ => (hview k).comap_le

/-- Each observed value is measurable using the information available at that time. -/
theorem measurable_observation (view : ℕ → Ω → V) (hview : ∀ n, Measurable (view n)) (n : ℕ) :
    @Measurable Ω V (observationFiltration view hview n) _ (view n) := by
  apply (comap_measurable (view n)).mono _ le_rfl
  exact le_iSup_of_le n (le_iSup_of_le le_rfl le_rfl)

/-- Coarsening each observation coarsens the entire available-information filtration. -/
theorem observationFiltration_le_of_factor (view : ℕ → Ω → V) (hview : ∀ n, Measurable (view n))
    (coarse : ℕ → Ω → W) (hcoarse : ∀ n, Measurable (coarse n))
    (f : ℕ → V → W) (hf : ∀ n, Measurable (f n)) (heq : ∀ n, coarse n = f n ∘ view n) :
    observationFiltration coarse hcoarse ≤ observationFiltration view hview := by
  intro n
  apply iSup_le
  intro k
  apply iSup_le
  intro hk
  rw [heq k, ← MeasurableSpace.comap_comp]
  exact (MeasurableSpace.comap_mono (hf k).comap_le).trans
    (le_iSup_of_le k (le_iSup_of_le hk le_rfl))

/-- A measurable decision from the finite observed history respects the public filtration. -/
theorem measurable_history_decision (view : ℕ → Ω → V) (hview : ∀ n, Measurable (view n))
    (n : ℕ) (decision : (Finset.Iic n → V) → W) (hdecision : Measurable decision) :
    @Measurable Ω W (observationFiltration view hview n) _
      (fun ω => decision (fun k => view k ω)) := by
  apply hdecision.comp
  refine @Measurable.of_eval Ω (Finset.Iic n) (fun _ => V)
    (observationFiltration view hview n) _ _ ?_
  intro k
  exact (@measurable_observation Ω V mΩ _ view hview k).mono
    ((observationFiltration view hview).mono (Finset.mem_Iic.mp k.property)) le_rfl

/-- The first occurrence of a publicly observable event is a stopping time for the public view. -/
theorem isStoppingTime_observed_hitting (view : ℕ → Ω → V) (hview : ∀ n, Measurable (view n))
    (event : Set V) (hevent : MeasurableSet event) :
    IsStoppingTime (observationFiltration view hview) (hittingAfter view event 0) := by
  intro n
  have heq : {ω | hittingAfter view event 0 ω ≤ (↑n : WithTop ℕ)} =
      ⋃ k : ℕ, ⋃ (_ : k ∈ Set.Icc 0 n), view k ⁻¹' event := by
    ext ω
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_preimage, exists_prop]
    convert (hittingAfter_le_iff (u := view) (s := event) (n := 0) (i := n) (ω := ω)) using 1
  have hm : MeasurableSet[observationFiltration view hview n]
      (⋃ k : ℕ, ⋃ (_ : k ∈ Set.Icc 0 n), view k ⁻¹' event) := by
    apply MeasurableSet.iUnion
    intro k
    apply MeasurableSet.iUnion
    intro hk
    exact ((measurable_observation view hview k).mono
      ((observationFiltration view hview).mono hk.2) le_rfl) hevent
  exact heq.symm ▸ hm

end Interaction
