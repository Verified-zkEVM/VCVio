module
public import VCVio.CryptoFoundations.MerkleTree.Salted.Conditions
public import VCVio.Quantum.VC.Proof.Extraction

/-!
# Sharp P3 for salted Merkle extraction

Opening one trapdoor produces at most `2L - 1` distinct pairs for a tree with at most `L` leaves.
Applying the opening-specific P3 theorem gives error `1 - (1 - 1/N)^(2 n (2L - 1))`, with
`N = |Y|`. The arbitrary-proof query bound in `checkIOForm` remains `q * (d + 1)`.

The statement uses the named salted Merkle multi-extractor and the old compressed oracle.
It is independent of the adversary's query and mass budgets. Extractor efficiency is separate.

## References

Chiesa–Di–Hu–Zheng, ePrint 2025/2166: Merkle openings (Definition 8.2, pp. 52–53),
extraction correctness (Definition 7.3, property 3, p. 51), and its general proof
(Lemma 9.3, pp. 59–61). The exact opening-cell P3 error proved here is a strengthened bound
using `2L - 1` cells from one trapdoor. Its formula is not the estimate stated in the paper's
Theorem 8.3 (p. 53); the compression step appears in the proof of Lemma 9.3 (p. 61).
-/

public section

open Quantum OracleComp
open scoped ENNReal

universe v w

namespace SaltedMerkle

variable {X Y Msg Salt : Type} [DecidableEq X] [LinearOrder Y] [SampleableType Salt]
  (enc : Encoding X Y Msg Salt) {k : ℕ} (d : Fin k → ℕ)

/-- Opening a single trapdoor for a tree of at most `L` leaves uses at most `2L - 1` pairs. -/
theorem openingQueryBound (L : ℕ) (hL : ∀ i, 2 ^ d i ≤ L) :
    OpeningQueryBound (fun i ↦ checkIOForm enc (d i)) (2 * L - 1) := by
  intro i rt ans td pf hpf pairs hpairs
  have heq : pf = opening (d i) ans.dom td := by
    simpa [scheme, DetVectorCommitment.toVectorCommitment] using hpf
  subst pf
  have h := length_outputIO_opening_le enc rt ans ans.dom td pairs hpairs
  have hi := hL i
  omega

variable {Y : Type} [Fintype Y] in
/-- The extraction error from at most `n` openings, each prescribing at most `2L - 1` cells. -/
@[expose]
noncomputable def extractErrorBound (L n : ℕ) : ℝ≥0∞ :=
  ENNReal.ofReal (1 - (1 - (Fintype.card Y : ℝ)⁻¹) ^ (2 * n * (2 * L - 1)))

variable [Fintype X] [Fintype Y] [AddCommGroup Y] [Fintype Msg] [LinearOrder Msg]
  [Fintype Salt] [LinearOrder Salt] {Z : Type} [Fintype Z] [DecidableEq Z] [AddGroup Z]
  (code : TpDCode k (DmOf (fun i ↦ 2 ^ d i) Msg fun i ↦ Td Y Salt (d i)) Z)

/-- Sharp P3 for salted Merkle trees with at most `L` leaves each:
`1 - (1 - 1/N)^(2 n (2L - 1))`. The cell budget applies to proofs generated by opening. -/
theorem extractionCorrect (L : ℕ) (hL : ∀ i, 2 ^ d i ≤ L) :
    ExtractionCorrect.{v, w} (fun i ↦ (scheme enc (d i)).toVectorCommitment)
      (compressedVCOracle k X Y) (multiExtract enc d) code
      (fun _ _ _ n ↦ extractErrorBound (Y := Y) L n) :=
  extractionCorrect_compressedVCOracle_of_openingQueryBound
    (fun i ↦ checkIOForm enc (d i)) (multiExtract enc d) code (2 * L - 1)
    (openingQueryBound enc d L hL) (conditions enc d)

/-- Sharp P3 for a family of trees of a common depth `depth`, with `L = 2 ^ depth`. -/
theorem extractionCorrect_uniformDepth (depth : ℕ)
    (code : TpDCode k (DmOf (fun _ ↦ 2 ^ depth) Msg fun _ ↦ Td Y Salt depth) Z) :
    ExtractionCorrect.{v, w} (fun _ : Fin k ↦ (scheme enc depth).toVectorCommitment)
      (compressedVCOracle k X Y) (multiExtract enc (fun _ ↦ depth)) code
      (fun _ _ _ n ↦ extractErrorBound (Y := Y) (2 ^ depth) n) :=
  extractionCorrect enc (fun _ ↦ depth) code (2 ^ depth) (fun _ ↦ le_rfl)

end SaltedMerkle
